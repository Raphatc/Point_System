{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sistema Distribuidora",
  "version": "0.1.0",
  "identifier": "com.distribuidora.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sistema Distribuidora",
        "width": 1400,
        "height": 930,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
